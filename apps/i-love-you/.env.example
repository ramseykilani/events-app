# I Love You — client configuration. Copy to apps/i-love-you/.env (gitignored).
# Both values are on the Supabase dashboard -> Project Settings -> API Keys.
# The publishable key is public by design; RLS is the security boundary.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key-here

# EAS project id, printed by `eas init` in apps/i-love-you (SETUP.md -> EAS).
# Read by app.config.js; not secret.
# ILY_EAS_PROJECT_ID=

# --- Not client variables: Supabase Edge Function secrets ---------------
# These are set on the hosted project with `npx supabase secrets set` (SETUP.md
# -> Edge Function secrets) and NEVER go in this file or the app bundle:
#   LIVEKIT_URL          wss://<your-project>.livekit.cloud
#   LIVEKIT_API_KEY      LiveKit Cloud -> Settings -> Keys
#   LIVEKIT_API_SECRET   (shown once, with the key)
# Twilio (phone OTP) is configured in the Supabase dashboard -> Authentication
# -> Sign In / Providers -> Phone, not here.
