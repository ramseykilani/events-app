{
  "name": "iloveyou-app",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 8091",
    "build:web": "expo export --platform web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:sql": "bash supabase/tests/run_local.sh",
    "test:e2e": "bash e2e/stack.sh up && playwright test",
    "test:e2e:mobile": "bash e2e/stack.sh up && playwright test --project=mobile-chrome",
    "stack:up": "bash e2e/stack.sh up",
    "stack:down": "bash e2e/stack.sh down",
    "serve:web": "serve -s dist -l 8091"
  },
  "expo": {
    "install": {
      "exclude": ["react-native-screens"]
    }
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "13.0.0",
    "@expo/vector-icons": "^15.0.3",
    "@family/design": "*",
    "@family/infra": "*",
    "@livekit/react-native": "2.9.8",
    "@livekit/react-native-expo-plugin": "1.0.3",
    "@livekit/react-native-webrtc": "137.0.3",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-navigation/native": "^7.1.28",
    "@supabase/supabase-js": "^2.95.3",
    "expo": "~54.0.33",
    "expo-audio": "~1.1.1",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "^18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-image-picker": "~17.0.10",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "^8.0.11",
    "expo-notifications": "~0.32.16",
    "expo-router": "^6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "libphonenumber-js": "^1.12.36",
    "livekit-client": "2.24.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "~19.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "^19.1.0",
    "serve": "^14.2.6",
    "supabase": "2.122.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
