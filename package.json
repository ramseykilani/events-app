{
  "name": "events-app",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "deploy:web": "npm run build:web && wrangler pages deploy",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile-safari --project=mobile-chrome",
    "test:conventions": "node scripts/check-conventions.mjs",
    "test:sql": "bash supabase/tests/run_local.sh",
    "serve:web": "serve -s dist -l 8081",
    "deploy:staging": "npm run build:web && wrangler pages deploy --branch=staging",
    "deploy:receipt": "wrangler pages deploy receipt --project-name=events-reply --branch=main",
    "test:manual": "bash ./scripts/manual-test-suite.sh",
    "test:manual:strict": "bash ./scripts/manual-test-suite.sh --strict",
    "test:manual:start": "bash ./scripts/manual-test-suite.sh --strict --start"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@supabase/supabase-js": "^2.95.3",
    "expo": "~54.0.33",
    "expo-calendar": "~15.0.8",
    "expo-constants": "^18.0.13",
    "expo-contacts": "^15.0.11",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.20",
    "expo-intent-launcher": "~13.0.8",
    "expo-keep-awake": "~15.0.8",
    "expo-linear-gradient": "^15.0.8",
    "expo-linking": "^8.0.11",
    "expo-notifications": "~0.32.16",
    "expo-router": "^6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "libphonenumber-js": "^1.12.36",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "~19.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "^19.1.0",
    "serve": "^14.2.6",
    "typescript": "~5.9.2",
    "wrangler": "^4.120.0"
  },
  "private": true
}
