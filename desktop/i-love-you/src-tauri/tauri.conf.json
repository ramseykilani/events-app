{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "I Love You",
  "version": "0.1.0",
  "identifier": "com.rkilani.iloveyou.desktop",
  "build": {
    "frontendDist": "../../../apps/i-love-you/dist",
    "beforeBuildCommand": "npm run build:web:ily --prefix ../../.."
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "I Love You",
        "width": 1180,
        "height": 780,
        "minWidth": 380,
        "minHeight": 560,
        "backgroundColor": "#faf7f0"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "shortDescription": "A private place for the two of you",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  }
}
