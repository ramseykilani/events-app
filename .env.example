EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key-here

# Optional, e2e only: password shared by the test accounts (see AGENTS.md →
# "Signing in (test accounts)"). Lets the Playwright setup sign in without
# firing SMS; OTP UI tests still work via sms_test_otp (no Twilio).
# E2E_ACCOUNT_PASSWORD=

# Optional, e2e only: the shared test OTP for the sms_test_otp-registered
# test numbers. Only the OTP-UI sign-in path needs it (password sign-in is
# the norm). Never commit the real value — the repo is public.
# E2E_TEST_OTP=
